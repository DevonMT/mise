# server/.env  (chmod 600 — Devon fills these in himself)
ANTHROPIC_API_KEY=

# Required now that this server is reachable from the internet via
# mise.devondoes.dev. Generate one with:  openssl rand -hex 24
# Enter the same value in the app: Settings -> Parse key.
PARSE_KEY=

# Comma-separated origins allowed to call /api/*. Leave blank for any origin
# (LAN/dev). In production this should be exactly where the PWA is served from.
ALLOWED_ORIGINS=https://devontroedel.com

# Backstop if PARSE_KEY leaks: max AI calls per day.
DAILY_CALL_CAP=200
