# server/.env on the mini  (chmod 600 — Devon fills in the secrets himself)
# Deployed alongside mise.service, which sets HOST=172.30.0.1.

PORT=8787

# Proves a request came through the platform gateway (mise.devondoes.dev),
# which signs the user in and sets X-Platform-User. Same value as the gateway's.
GATEWAY_TOKEN=

# Cloudflare Access, the older door; optional once the gateway is the only one.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Comma-separated origins allowed to call /api/*.
ALLOWED_ORIGINS=https://mise.devondoes.dev

# Backstop: max AI calls per day.
DAILY_CALL_CAP=200

# No Anthropic key: the ai-broker holds the only one, enforces this app's
# monthly budget and audits every call.
BROKER_URL=http://172.30.0.1:8610
